# Ambiente (opcional, padrão development).
# Em production, o TypeORM só faz `synchronize` (auto-DDL) se DB_SYNC=true —
# use isso só por um boot, pra aplicar mudança de schema, depois desligue de novo.
NODE_ENV=development
DB_SYNC=

# Banco Oracle (FIAP)
DB_HOST=
DB_PORT=1521
DB_USER=
DB_PASS=
DB_SERVICE=ORCL

# Agente de IA. Opcional — sem chave, a extração roda em modo determinístico
# (só specs-base lidas por regra do PDF, sem preenchimento por IA).
ANTHROPIC_API_KEY=

# Assinatura dos tokens JWT (login/refresh). Mínimo 32 caracteres — gere com:
#   openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Chave AES-256-GCM do payload do audit log. Precisa decodificar pra exatamente
# 32 bytes — hex de 64 caracteres ou base64 de 44. Gere com:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Senha mestra exigida em POST /api/auth/register (adminKey) para criar o
# primeiro usuário. Mínimo 16 caracteres — gere com:
#   openssl rand -hex 24
API_KEY=

# Porta da API (opcional, padrão 3333)
PORT=3333

# Origens extras liberadas no CORS, além de localhost/127.0.0.1/192.168.x.x (opcional, separadas por vírgula)
ALLOWED_ORIGINS=
